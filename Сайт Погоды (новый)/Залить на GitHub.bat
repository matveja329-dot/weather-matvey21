@echo off
chcp 65001 >nul
cd /d "%~dp0"
echo ============================================
echo   Заливаю обновление сайта погоды на GitHub
echo ============================================
echo.
echo Если откроется окно входа — войди в свой GitHub
echo (это нужно только в первый раз, потом запомнит).
echo.
"C:\Program Files\Git\cmd\git.exe" push -u origin main
echo.
if %errorlevel%==0 (
  echo --- ГОТОВО! Изменения улетели на GitHub. ---
  echo Подожди ~1 минуту и переоткрой приложение на телефоне.
) else (
  echo --- Что-то пошло не так. Напиши мне код ошибки выше. ---
)
echo.
pause
